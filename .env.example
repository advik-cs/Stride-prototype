# ==============================================================================
# STRIDE — Environment Configuration Template
# Copy this file to .env and adjust variables as required.
# ==============================================================================

# Server Listening Port (Default: 3000)
PORT=3000

# Relational Database Connection URL (SQLite local file by default)
DATABASE_URL="file:./dev.db"

# JWT Signing Secret Key for User Session Tokens
JWT_SECRET="stride-hackathon-secure-jwt-secret-key-2026"

# Google Gemini API Key (For multimodal voice emergency triage and Live API)
# Obtain a key from: https://aistudio.google.com/
# If omitted, STRIDE seamlessly activates its rule-based regex fallback extractor.
GEMINI_API_KEY=""

# Deepgram API Key (For turn-based STT & TTS voice emergency assistant)
# Server-side only (never expose with VITE_ prefix). Obtain from: https://console.deepgram.com/
DEEPGRAM_API_KEY=""
# Deepgram STT Model (Default: "nova-3")
DEEPGRAM_STT_MODEL="nova-3"
# Deepgram TTS Model (Default: "aura-asteria-en")
DEEPGRAM_TTS_MODEL="aura-asteria-en"
# Deepgram Nova-3 Keyterms (Optional comma-separated emergency vocabulary override)
# DEEPGRAM_KEYTERMS="trapped,trapped upstairs,need rescue,water rising,fire,injured,heavily injured,seriously unwell,physically disabled,children,infants,elderly,grandmother,grandfather,rescue,bleeding,unconscious,missing,cannot move"

# ------------------------------------------------------------------------------
# Voice Assistant Provider & Model Configuration
# ------------------------------------------------------------------------------
# Active voice provider for citizen assistant (Options: "deepgram", "gemini", Default: "gemini")
# VITE_VOICE_PROVIDER="deepgram"
# Gemini Live API model (Default: "gemini-3.8-live")
# GEMINI_LIVE_MODEL="gemini-3.8-live"

# ------------------------------------------------------------------------------
# Optional Frontend API Base Overrides
# In unified mode on port 3000, these automatically default to /api.
# ------------------------------------------------------------------------------
# VITE_API_BASE_URL=""
# VITE_BEFORE_API_URL="http://localhost:4000/api"
# VITE_DURING_API_URL="http://localhost:5000/api"
# VITE_FLOODX_EMBED_URL="http://localhost:3001"
